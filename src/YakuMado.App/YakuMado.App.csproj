<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 配布用publish設定(dotnet publish -c Release時に有効): 単一実行ファイル・自己完結型 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- WFAC010: WinForms(NotifyIcon用)アナライザはApplication.SetHighDpiMode APIでの設定を推奨するが、
         本アプリは主にWPFのためmanifestベースのPerMonitorV2指定を採用する(意図的な選択) -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YakuMado.Core\YakuMado.Core.csproj" />
    <ProjectReference Include="..\YakuMado.Settings\YakuMado.Settings.csproj" />
    <ProjectReference Include="..\YakuMado.TextAcquisition\YakuMado.TextAcquisition.csproj" />
    <ProjectReference Include="..\YakuMado.Translation.Orchestration\YakuMado.Translation.Orchestration.csproj" />
    <ProjectReference Include="..\YakuMado.Translation.Cloud\YakuMado.Translation.Cloud.csproj" />
    <ProjectReference Include="..\YakuMado.Translation.Local\YakuMado.Translation.Local.csproj" />
    <ProjectReference Include="..\YakuMado.Overlay\YakuMado.Overlay.csproj" />
    <ProjectReference Include="..\YakuMado.Ocr\YakuMado.Ocr.csproj" />
  </ItemGroup>

</Project>
